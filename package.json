{
  "name": "devtree",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Code-verified developer skill trees powered by GitHub evidence and local AI.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/LimaCxu/devtree.git" },
  "homepage": "https://github.com/LimaCxu/devtree#readme",
  "bugs": { "url": "https://github.com/LimaCxu/devtree/issues" },
  "keywords": ["github", "developer-tools", "skill-tree", "ollama", "career", "typescript"],
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build && npm run compile:server",
    "compile:server": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node dist-server/server/index.js",
    "worker": "node dist-server/server/worker.js",
    "test": "npm run compile:server && node --test dist-server/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  }
}
